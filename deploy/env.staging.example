# Salin ke apps/api/.env.staging pada server. Nilai ini hanya contoh.
IMAGE_PREFIX=ghcr.io/latveriacademy/latveria
IMAGE_TAG=staging
WEB_BIND=127.0.0.1
WEB_PORT=8081

POSTGRES_USER=latveria
POSTGRES_DB=latveria
# Gunakan openssl rand -hex 32, lalu pakai password yang sama dalam kedua URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://latveria:REPLACE_PASSWORD@postgres:5432/latveria
DATABASE_MIGRATION_URL=postgresql://latveria:REPLACE_PASSWORD@postgres:5432/latveria

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://staging.latveria.example.com
ALLOW_SIGN_UP=true

# S3 Storage (RustFS bawaan)
S3_ACCESS_KEY_ID=latveria
# Gunakan openssl rand -hex 16
S3_SECRET_ACCESS_KEY=
S3_BUCKET=latveria-avatars
STORAGE_CONSOLE_BIND=127.0.0.1
STORAGE_CONSOLE_PORT=9003
# S3_ENDPOINT=http://storage:9000
# S3_REGION=us-east-1
# S3_PUBLIC_URL=/api/avatar

# Watchtower (nickfedor/watchtower) untuk auto-update container staging berlabel
WATCHTOWER_POLL_INTERVAL=300
# Autentikasi GHCR private (pilih opsi A: REPO_USER & REPO_PASS atau opsi B: DOCKER_CONFIG_PATH)
GHCR_USER=
GHCR_PAT=
# DOCKER_CONFIG_PATH=/home/ubuntu/.docker/config.json
