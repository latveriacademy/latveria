# Salin menjadi apps/web/.env.local. Jangan simpan kredensial asli dalam Git.
# Aplikasi: URL PostgreSQL Supabase Transaction pooler (biasanya port 6543).
DATABASE_URL=
# Migrasi: URL Direct connection atau Session pooler (port 5432).
# Session pooler dapat digunakan jika lingkungan tidak mendukung IPv6.
DATABASE_MIGRATION_URL=
# Disiapkan untuk tahap autentikasi; belum digunakan oleh aplikasi P0.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
