{
  "name": "@latveria/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun --watch --env-file=.env.local src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "typecheck": "bun run --bun tsc --noEmit",
    "build": "bun run --bun tsc --noEmit",
    "test": "bun run --bun vitest run",
    "test:integration": "NODE_ENV=development bun scripts/verify-api.ts && NODE_ENV=development bun scripts/verify-admin.ts && NODE_ENV=development bun scripts/verify-warrior.ts",
    "db:generate": "bun run --bun drizzle-kit generate",
    "db:migrate": "bun scripts/migrate-db.ts",
    "db:seed": "bun scripts/seed-db.ts",
    "db:check": "bun scripts/check-db.ts",
    "db:admin": "bun scripts/promote-admin.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.6",
    "@latveria/shared": "workspace:*",
    "better-auth": "1.7.6",
    "drizzle-orm": "0.45.3",
    "hono": "^4.13.11",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "~1.3.14",
    "drizzle-kit": "0.31.11",
    "typescript": "~5.9.3",
    "vitest": "5.0.2"
  }
}
