# Salin menjadi apps/api/.env.local. Jangan simpan kredensial asli dalam Git.
# Default pengembangan lokal melalui compose.yaml (kredensial dummy).
DATABASE_URL=postgresql://latveria:latveria@localhost:5433/latveria
DATABASE_MIGRATION_URL=postgresql://latveria:latveria@localhost:5433/latveria
# Untuk Supabase: ganti DATABASE_URL dengan Transaction pooler,
# dan DATABASE_MIGRATION_URL dengan Direct connection atau Session pooler.
# Wajib untuk login lokal. Buat secret acak dengan: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Opsional, hanya backend development: hostname Cloudflare Tunnel HTTPS yang dipercaya.
# DEV_TUNNEL_ORIGIN=https://latveria.dorrit.dev
# Dev API default 3001; produksi default 3000 dan melayani frontend hasil build.
# PORT=3001

# Object Storage S3-compatible (MinIO untuk dev, Cloudflare R2 / AWS S3 untuk produksi)
# MinIO lokal dev berjalan via compose.yaml (API port 9002, Console port 9003)
S3_ENDPOINT=http://127.0.0.1:9002
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=latveria
S3_SECRET_ACCESS_KEY=latveria123
S3_BUCKET=latveria-avatars
S3_PUBLIC_URL=/api/avatar

# Batasan ukuran foto profil (min 5 KB, maks 3 MB — tidak terlalu kecil, tidak terlalu besar)
AVATAR_MIN_SIZE_BYTES=5120
AVATAR_MAX_SIZE_BYTES=3145728
