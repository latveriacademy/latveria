# Salin menjadi apps/api/.env.local. Jangan simpan kredensial asli dalam Git.
# Default pengembangan lokal melalui compose.yaml (kredensial dummy).
DATABASE_URL=postgresql://latveria:latveria@localhost:5433/latveria
DATABASE_MIGRATION_URL=postgresql://latveria:latveria@localhost:5433/latveria
# Untuk Supabase: ganti DATABASE_URL dengan Transaction pooler,
# dan DATABASE_MIGRATION_URL dengan Direct connection atau Session pooler.
# Wajib untuk login lokal. Buat secret acak dengan: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Dev API default 3001; produksi default 3000 dan melayani frontend hasil build.
# PORT=3001
