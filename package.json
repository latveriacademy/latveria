{
  "name": "latveria",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": ["esbuild"],
  "engines": {
    "node": ">=22.12.0 <23",
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun run --parallel --filter '@latveria/web' --filter '@latveria/api' dev",
    "build": "bun run --filter '@latveria/*' --if-present build",
    "start": "bun run --filter @latveria/api start",
    "lint": "eslint apps/*/src apps/api/scripts packages/shared/src",
    "typecheck": "bun run --filter '@latveria/*' typecheck",
    "test": "bun run --filter '@latveria/*' test",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "test:integration": "bun run --filter @latveria/api test:integration",
    "test:containers": "node scripts/verify-containers.mjs",
    "db:generate": "bun run --filter @latveria/api db:generate",
    "db:migrate": "bun run --filter @latveria/api db:migrate",
    "db:check": "bun run --filter @latveria/api db:check",
    "db:seed": "bun run --filter @latveria/api db:seed",
    "db:admin": "bun run --filter @latveria/api db:admin"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "typescript-eslint": "^8.71.0"
  }
}
