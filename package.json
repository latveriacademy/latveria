{
  "name": "latveria",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @latveria/web --filter @latveria/api dev",
    "build": "pnpm -r --if-present build",
    "start": "pnpm --filter @latveria/api start",
    "lint": "eslint apps/*/src apps/api/scripts packages/shared/src",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @latveria/api db:generate",
    "db:migrate": "pnpm --filter @latveria/api db:migrate",
    "db:check": "pnpm --filter @latveria/api db:check",
    "db:seed": "pnpm --filter @latveria/api db:seed",
    "db:admin": "pnpm --filter @latveria/api db:admin"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "typescript-eslint": "^8.71.0"
  }
}
